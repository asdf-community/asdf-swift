#!/usr/bin/env bash

function error() {
  echo -e "\033[0;31merror:\033[0m $1"
  exit 1
}

function check_deps() {
  command -v curl >/dev/null 2>&1 || error "curl is required for downloading"
  command -v tar >/dev/null 2>&1 || error "tar is required for extraction"
  command -v jq >/dev/null 2>&1 || error "jq is required for json parsing"
}
